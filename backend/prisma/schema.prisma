// Prisma schema for BrewLite project
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Bảng Người dùng & Xác thực
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  fullName      String?  @map("full_name")
  phone         String?  @map("phone")
  loyaltyPoints Int      @default(0) @map("loyalty_points")
  role          String   @default("CUSTOMER") // CUSTOMER, BARISTA, ADMIN
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relationships
  orders        Order[]
  stockReceipts StockReceipt[]
  cart          Cart?

  @@map("users")
}

// 2. Bảng Danh mục đồ uống
model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relationships
  products Product[]

  @@map("categories")
}

// 3. Bảng Món / Đồ uống
model Product {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  name        String
  description String?
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 2)
  costPrice   Decimal? @map("cost_price") @db.Decimal(10, 2) // Giá vốn COGS tự động tính từ BOM
  imageUrl    String?  @map("image_url")
  stock       Int      @default(100)
  version     Int      @default(1) // Optimistic Lock
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relationships
  category   Category        @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  recipes    ProductRecipe[]
  cartItems  CartItem[]

  @@map("products")
}

// 4. Bảng Topping
model Topping {
  id          String  @id @default(uuid())
  name        String
  price       Decimal @db.Decimal(10, 2)
  stock       Int?    @default(100)
  isAvailable Boolean @default(true) @map("is_available")

  // Relationships
  orderItemToppings OrderItemTopping[]

  @@map("toppings")
}

// 5. Bảng Khuyến mãi / Voucher
model Promotion {
  code              String    @id
  discountType      String    @map("discount_type") // PERCENTAGE, FIXED_AMOUNT
  discountValue     Decimal   @map("discount_value") @db.Decimal(10, 2)
  minOrderAmount    Decimal?  @map("min_order_amount") @db.Decimal(10, 2)
  maxDiscountAmount Decimal?  @map("max_discount_amount") @db.Decimal(10, 2)
  validUntil        DateTime? @map("valid_until")
  isActive          Boolean   @default(true) @map("is_active")

  // Relationships
  orders Order[]

  @@map("promotions")
}

// 6. Bảng Đơn hàng
model Order {
  id              String   @id @default(uuid())
  orderCode       String   @unique @map("order_code") @db.VarChar(20)
  userId          String?  @map("user_id") // Nullable cho khách vãng lai
  customerName    String   @map("customer_name")
  phone           String
  deliveryAddress String?  @map("delivery_address")
  notes           String?
  promotionCode   String?  @map("promotion_code")
  status          String   @default("PENDING") // PENDING, PAID, PREPARING, READY, COMPLETED, CANCELLED
  subtotal        Decimal  @db.Decimal(10, 2)
  discountAmount  Decimal  @default(0) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount     Decimal  @map("total_amount") @db.Decimal(10, 2)
  pointsEarned    Int?     @default(0) @map("points_earned")
  isInventoryDeducted Boolean   @default(false) @map("is_inventory_deducted")
  inventoryDeductedAt DateTime? @map("inventory_deducted_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relationships
  user                  User?                  @relation(fields: [userId], references: [id])
  promotion             Promotion?             @relation(fields: [promotionCode], references: [code])
  orderItems            OrderItem[]
  payments              Payment[]
  statusHistory         OrderStatusHistory[]
  inventoryTransactions InventoryTransaction[]

  @@map("orders")
}

// 7. Bảng Chi tiết món trong đơn
model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  size      String  @db.VarChar(5) // S, M, L
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  qty       Int
  lineTotal Decimal @map("line_total") @db.Decimal(10, 2)

  // Relationships
  order    Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product            @relation(fields: [productId], references: [id])
  toppings OrderItemTopping[]

  @@map("order_items")
}

// 8. Bảng Topping đi kèm món trong đơn
model OrderItemTopping {
  id          String  @id @default(uuid())
  orderItemId String  @map("order_item_id")
  toppingId   String  @map("topping_id")
  price       Decimal @db.Decimal(10, 2)

  // Relationships
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  topping   Topping   @relation(fields: [toppingId], references: [id])

  @@map("order_item_toppings")
}

// 9. Bảng Thanh toán
model Payment {
  id             String   @id @default(uuid())
  orderId        String   @map("order_id")
  idempotencyKey String   @unique @map("idempotency_key")
  method         String   // VNPAY, MOMO, CASH, BANK_TRANSFER, CARD
  status         String   @default("PENDING") // PENDING, SUCCESS, FAILED
  amount         Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  // Relationships
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// 10. Bảng Nguyên liệu (Ingredients)
model Ingredient {
  id           String   @id @default(uuid())
  name         String   @unique
  unit         String   // 'g', 'ml', 'piece'
  baseUnit     String?  @default("g") @map("base_unit") // Đơn vị cơ sở chuẩn hóa
  currentStock Decimal  @default(0) @map("current_stock") @db.Decimal(12, 2)
  minimumStock Decimal  @default(100) @map("minimum_stock") @db.Decimal(12, 2)
  costPerUnit  Decimal  @default(0) @map("cost_per_unit") @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relationships
  recipes               ProductRecipe[]
  stockReceiptItems     StockReceiptItem[]
  inventoryTransactions InventoryTransaction[]

  @@map("ingredients")
}

// 11. Bảng Định lượng / Công thức sản phẩm (Product Recipes / Bill of Materials)
model ProductRecipe {
  id           String   @id @default(uuid())
  productId    String   @map("product_id")
  ingredientId String   @map("ingredient_id")
  size         String?  @db.VarChar(5) // 'S', 'M', 'L' hoặc null (áp dụng chung)
  amount       Decimal  @db.Decimal(10, 2) // Định lượng tiêu hao cho 1 ly
  wasteRate    Decimal  @default(0) @map("waste_rate") @db.Decimal(5, 2) // Tỷ lệ hao hụt (%)
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  // Relationships
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId, size])
  @@map("product_recipes")
}

// 12. Bảng Phiếu nhập kho (Stock Receipts)
model StockReceipt {
  id           String   @id @default(uuid())
  receiptCode  String   @unique @map("receipt_code") @db.VarChar(30)
  supplier     String?
  totalCost    Decimal  @default(0) @map("total_cost") @db.Decimal(12, 2)
  notes        String?
  receivedById String?  @map("received_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relationships
  receivedBy            User?                  @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  items                 StockReceiptItem[]
  inventoryTransactions InventoryTransaction[]

  @@map("stock_receipts")
}

// 13. Bảng Chi tiết phiếu nhập kho (Stock Receipt Items)
model StockReceiptItem {
  id           String  @id @default(uuid())
  receiptId    String  @map("receipt_id")
  ingredientId String  @map("ingredient_id")
  quantity     Decimal @db.Decimal(12, 2)
  unitCost     Decimal @map("unit_cost") @db.Decimal(10, 2)
  totalPrice   Decimal @map("total_price") @db.Decimal(12, 2)

  // Relationships
  receipt    StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  ingredient Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@map("stock_receipt_items")
}

// 14. Bảng Lịch sử giao dịch / biến động tồn kho (Inventory Transactions)
model InventoryTransaction {
  id             String        @id @default(uuid())
  ingredientId   String        @map("ingredient_id")
  type           String        // 'RECEIPT', 'ORDER_DEDUCT', 'RESTOCK', 'ADJUSTMENT'
  quantity       Decimal       @db.Decimal(12, 2) // Âm khi xuất, dương khi nhập
  balanceAfter   Decimal       @map("balance_after") @db.Decimal(12, 2)
  referenceType  String?       @map("reference_type") // 'ORDER', 'STOCK_RECEIPT', 'MANUAL'
  orderId        String?       @map("order_id")
  stockReceiptId String?       @map("stock_receipt_id")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")

  // Relationships
  ingredient   Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  stockReceipt StockReceipt? @relation(fields: [stockReceiptId], references: [id], onDelete: SetNull)

  @@map("inventory_transactions")
}

// 15. Bảng Lịch sử trạng thái đơn hàng (Order Status History)
model OrderStatusHistory {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  reason     String?
  changedBy  String?  @map("changed_by")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relationships
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

// 16. Bảng Giỏ hàng theo User (Carts)
model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

// 17. Bảng Chi tiết món trong Giỏ hàng (Cart Items)
model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  size      String   @db.VarChar(5)
  quantity  Int      @default(1)
  milk      String?
  note      String?
  toppings  String?  // JSON string các toppingIds
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("cart_items")
}
