    {
      "name": "05. Orders (Đơn hàng & State Machine)",
      "item": [
        {
          "name": "01. Kiểm tra mã Voucher (validate-voucher)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"WELCOME10\",\n  \"subtotal\": 58000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/validate-voucher",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "validate-voucher"]
            }
          }
        },
        {
          "name": "02. Tạo đơn hàng mới (Chờ thanh toán: PENDING) [Lưu currentOrderId]",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "    pm.collectionVariables.set('currentOrderId', res.id);",
                  "    pm.environment.set('currentOrderId', res.id);",
                  "    pm.globals.set('currentOrderId', res.id);",
                  "    console.log('Saved currentOrderId:', res.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCustomer}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Nguyễn Văn A\",\n  \"phone\": \"0903334444\",\n  \"deliveryAddress\": \"123 Nguyễn Văn Cừ, Q.5, TP.HCM\",\n  \"notes\": \"Giao nhanh giúp mình\",\n  \"promotionCode\": \"WELCOME10\",\n  \"useLoyaltyPoints\": 0,\n  \"items\": [\n    {\n      \"productId\": \"p1111111-1111-1111-1111-222222222222\",\n      \"size\": \"M\",\n      \"qty\": 2,\n      \"toppingIds\": [\"t1111111-1111-1111-1111-111111111111\"]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "03. Xem các trạng thái kế tiếp hợp lệ theo State Machine",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders/{{currentOrderId}}/allowed-transitions",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{currentOrderId}}", "allowed-transitions"]
            }
          }
        },
        {
          "name": "04. Chuyển trạng thái: Đã thanh toán (PAID) [Trừ kho BOM + Tích điểm]",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBarista}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PAID\",\n  \"reason\": \"Khách thanh toán thành công tại quầy/VNPAY\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{currentOrderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{currentOrderId}}", "status"]
            }
          }
        },
        {
          "name": "05. Chuyển trạng thái: Thanh toán lỗi / Hủy thanh toán (PAYMENT_FAILED)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBarista}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PAYMENT_FAILED\",\n  \"reason\": \"Khách hủy thanh toán hoặc giao dịch ngân hàng thất bại\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{currentOrderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{currentOrderId}}", "status"]
            }
          }
        },
        {
          "name": "06. Chuyển trạng thái: Bắt đầu làm đơn (PAID -> PREPARING)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBarista}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PREPARING\",\n  \"reason\": \"Barista bắt đầu pha chế món\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{currentOrderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{currentOrderId}}", "status"]
            }
          }
        },
        {
          "name": "07. Chuyển trạng thái: Đã làm xong đơn (PREPARING -> READY)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBarista}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"READY\",\n  \"reason\": \"Pha chế hoàn tất, để tại quầy chờ khách lấy\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{currentOrderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{currentOrderId}}", "status"]
            }
          }
        },
        {
          "name": "08. Chuyển trạng thái: Khách tới lấy và hoàn thành (READY -> COMPLETED)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBarista}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\",\n  \"reason\": \"Khách đã tới quầy nhận đồ uống thành công\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{currentOrderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{currentOrderId}}", "status"]
            }
          }
        },
        {
          "name": "09. HỦY ĐƠN HÀNG nếu chưa làm (POST /orders/:id/cancel) [Hoàn kho & hoàn điểm]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCustomer}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Khách hàng đổi ý muốn hủy đơn khi chưa pha chế\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{currentOrderId}}/cancel",
