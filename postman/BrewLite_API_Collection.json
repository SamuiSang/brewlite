    {
      "name": "05. Orders (Đơn hàng & State Machine)",
      "item": [
        {
          "name": "Kiểm tra mã Voucher (validate-voucher)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"WELCOME10\",\n  \"subtotal\": 58000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/validate-voucher",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "validate-voucher"]
            }
          }
        },
        {
          "name": "Tạo đơn hàng mới (Tự động trừ kho theo BOM & lưu currentOrderId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "    pm.collectionVariables.set('currentOrderId', res.id);",
                  "    pm.environment.set('currentOrderId', res.id);",
                  "    pm.globals.set('currentOrderId', res.id);",
                  "    console.log('Saved currentOrderId:', res.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCustomer}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Nguyễn Văn A\",\n  \"phone\": \"0903334444\",\n  \"deliveryAddress\": \"123 Nguyễn Văn Cừ, Q.5, TP.HCM\",\n  \"notes\": \"Giao nhanh giúp mình\",\n  \"promotionCode\": \"WELCOME10\",\n  \"useLoyaltyPoints\": 0,\n  \"items\": [\n    {\n      \"productId\": \"p1111111-1111-1111-1111-222222222222\",\n      \"size\": \"M\",\n      \"qty\": 2,\n      \"toppingIds\": [\"t1111111-1111-1111-1111-111111111111\"]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Lấy danh sách đơn hàng của tôi (Khách hàng)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCustomer}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/me",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "me"]
            }
          }
        },
        {
          "name": "Lấy danh sách đơn hàng hệ thống (Barista/Admin xem)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBarista}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders?status=PENDING",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                }
              ]
            }
          }
        },
        {
          "name": "Tra cứu đơn hàng theo Order Code (VD: #1001 hoặc 1001)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders/code/1001",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "code", "1001"]
            }
          }
        },
        {
          "name": "Xem các trạng thái kế tiếp hợp lệ theo State Machine",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders/{{currentOrderId}}/allowed-transitions",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{currentOrderId}}", "allowed-transitions"]
            }
          }
        },
        {
          "name": "Lấy chi tiết đơn hàng (Kiểm tra quyền)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCustomer}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{currentOrderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{currentOrderId}}"]
            }
          }
        },
        {
          "name": "Cập nhật trạng thái đơn (State Machine: PENDING -> PREPARING)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBarista}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PREPARING\",\n  \"reason\": \"Barista bat dau pha che mon\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{currentOrderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{currentOrderId}}", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "06. Payments & VNPAY (Thanh toán)",
      "item": [
        {
          "name": "Lấy cấu hình test & số thẻ VNPAY Sandbox",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/payments/vnpay/config",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "vnpay", "config"]
            }
          }
        },
        {
          "name": "Tạo URL thanh toán VNPAY Sandbox",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{currentOrderId}}\",\n  \"bankCode\": \"NCB\",\n  \"language\": \"vn\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/vnpay/create-url",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "vnpay", "create-url"]
            }
          }
        },
        {
          "name": "Thanh toán Mock (Kèm Idempotency-Key chống trùng lặp)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.payment && res.payment.id) {",
                  "    pm.collectionVariables.set('currentPaymentId', res.payment.id);",
                  "    pm.environment.set('currentPaymentId', res.payment.id);",
                  "    pm.globals.set('currentPaymentId', res.payment.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "order-pay-key-001"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{currentOrderId}}\",\n  \"method\": \"MOMO\",\n  \"mockSuccess\": true,\n  \"twoStep\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": ["{{baseUrl}}"],
              "path": ["payments"]
            }
          }
        },
        {
