                "key": "Authorization",
                "value": "Bearer {{tokenBarista}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actualStock\": 3500,\n  \"reason\": \"Kiem ke dinh ky cuoi ngay\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/inventory/ingredients/ing-1/adjust",
              "host": ["{{baseUrl}}"],
              "path": ["inventory", "ingredients", "ing-1", "adjust"]
