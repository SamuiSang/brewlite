    {
      "name": "04. Inventory & BOM (Quản lý kho & Định lượng)",
      "item": [
        {
          "name": "Lấy danh sách 17 nguyên liệu kho & mức an toàn",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/inventory/ingredients",
              "host": ["{{baseUrl}}"],
              "path": ["inventory", "ingredients"]
            }
          }
        },
        {
          "name": "Kiểm tra tính khả dụng giỏ hàng với BOM tồn kho (validate-cart)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"p1111111-1111-1111-1111-222222222222\",\n      \"size\": \"M\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/inventory/validate-cart",
              "host": ["{{baseUrl}}"],
              "path": ["inventory", "validate-cart"]
            }
          }
        },
        {
          "name": "Tính số ly tối đa có thể pha theo nguyên liệu kho",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/inventory/availability/p1111111-1111-1111-1111-222222222222?size=M",
              "host": ["{{baseUrl}}"],
              "path": ["inventory", "availability", "p1111111-1111-1111-1111-222222222222"],
              "query": [
                {
                  "key": "size",
                  "value": "M"
                }
              ]
            }
          }
        },
        {
          "name": "Tổng quan công thức tất cả sản phẩm & COGS",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/inventory/recipes",
              "host": ["{{baseUrl}}"],
              "path": ["inventory", "recipes"]
            }
          }
        },
        {
          "name": "Chi tiết công thức định lượng (BOM) 1 sản phẩm",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/inventory/recipes/p1111111-1111-1111-1111-222222222222",
              "host": ["{{baseUrl}}"],
              "path": ["inventory", "recipes", "p1111111-1111-1111-1111-222222222222"]
            }
          }
