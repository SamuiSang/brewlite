          "name": "Đăng nhập Khách hàng (Lưu tokenCustomer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "    pm.collectionVariables.set('tokenCustomer', res.accessToken);",
                  "    pm.environment.set('tokenCustomer', res.accessToken);",
                  "    pm.globals.set('tokenCustomer', res.accessToken);",
                  "    console.log('Saved tokenCustomer successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"khachhang@gmail.com\",\n  \"password\": \"Password123\"\n}"
            },
